# The inspected Singapore service currently has no explicit environment
# variables. Add these later if you want Terraform to manage them.
public_env = {}

# Map runtime env var names to existing Secret Manager secret ids only after the
# secrets exist in vylerawebsite. The currently inspected Singapore service had
# no secret env vars attached.
secret_env = {}

# GitHub Actions is the intended deployment path. Keep the old Google-created
# Cloud Build trigger disabled to avoid duplicate deploys on pushes to main.
disable_legacy_cloud_build_trigger = true
